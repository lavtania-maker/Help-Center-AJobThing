    .sort(function(x,y){var sc=function(a){var t=a.t.toLowerCase(),n=0;
      groups.forEach(function(g){if(g.some(function(w){return t.indexOf(w)>-1;}))n+=2;});
      if(t.indexOf(s.toLowerCase())>-1)n+=3;return n;};return sc(y)-sc(x);});
