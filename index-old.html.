<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AJobThing - Help Center</title>
<meta name="description" content="AJobThing Help Center - find help with posting jobs, managing applicants, finding candidates, credits and billing.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
/* ============ AJobThing design tokens (measured from ajobthing.com) ============ */
:root{
  --orange:#FAA221;          /* primary  rgb(250,162,33) */
  --orange-dk:#F99808;       /* border / hover */
  --orange-tint:#FEF6EA;
  --ink:#4B5563;             /* body + question text */
  --ink-strong:#374151;
  --ink-soft:#6B7280;
  --ink-faint:#9CA3AF;
  --page:#F5F7FB;            /* site background */
  --white:#FFFFFF;
  --line:#E5E7EB;            /* card border */
  --line-input:#DEE2E6;
  --nav-line:#CED5DE;
  --blue:#4A90E2;
  --r:6px;
  --sh:0 2px 4px rgba(0,0,0,.075);
  --nav-h:61px;
  --maxw:1400px;
  --font:"Open Sans",system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans","Liberation Sans",Arial,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--page);color:var(--ink);font-family:var(--font);
  font-size:14px;line-height:1.55;-webkit-font-smoothing:antialiased;
  display:flex;flex-direction:column;min-height:100vh}
a{color:inherit;text-decoration:none}
img{max-width:100%}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 20px;width:100%}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ============ site navbar (matches ajobthing.com) ============ */
.nav{position:sticky;top:0;z-index:80;background:var(--white);border-bottom:1px solid var(--nav-line)}
.nav .wrap{display:flex;align-items:center;height:var(--nav-h);gap:20px}
.brand{display:flex;flex-direction:column;justify-content:center;flex-shrink:0}
.brand img{height:30px;width:auto;display:block}
.brand small{font-size:9.5px;font-weight:600;color:var(--ink-soft);letter-spacing:.01em;margin-top:2px}
.navlinks{display:flex;align-items:center;gap:26px;margin-left:auto}
.navlinks>a{font-size:14px;font-weight:400;color:var(--ink);white-space:nowrap;padding:4px 0;
  border-bottom:2px solid transparent;transition:color .15s,border-color .15s}
.navlinks>a:hover{color:var(--orange)}
.navlinks>a.on{color:var(--orange);font-weight:600;border-bottom-color:var(--orange)}
.navlinks>a.mlogin{display:none}
.navbtns{display:flex;align-items:center;gap:10px;flex-shrink:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:inherit;
  font-size:14px;font-weight:700;border-radius:4px;padding:6px 25px;border:1px solid var(--orange-dk);
  cursor:pointer;white-space:nowrap;transition:background .15s,color .15s,box-shadow .15s}
.btn-o{background:transparent;color:var(--orange)}
.btn-o:hover{background:var(--orange-tint);color:var(--orange-dk)}
.btn-p{background:var(--orange);color:#fff}
.btn-p:hover{background:var(--orange-dk);color:#fff}
.burger{display:none;margin-left:auto;background:none;border:1px solid var(--line-input);border-radius:4px;
  padding:7px 9px;cursor:pointer;color:var(--ink)}
.burger svg{display:block}

/* ============ help center sub-bar ============ */
.subbar{background:var(--white);border-bottom:1px solid var(--line);position:sticky;top:var(--nav-h);z-index:70}
.subbar .wrap{display:flex;align-items:center;gap:22px;height:46px;overflow-x:auto;scrollbar-width:none}
.subbar .wrap::-webkit-scrollbar{display:none}
.subbar .hc{font-size:15px;font-weight:700;color:var(--ink-strong);white-space:nowrap;flex-shrink:0}
.subbar .hc b{color:var(--orange)}
.subbar nav{display:flex;gap:20px;margin-left:auto}
.subbar nav a{font-size:13.5px;color:var(--ink-soft);white-space:nowrap;padding:2px 0;border-bottom:2px solid transparent}
.subbar nav a:hover{color:var(--orange)}
.subbar nav a[aria-current]{color:var(--orange);font-weight:600;border-bottom-color:var(--orange)}

/* ============ page head + search (mirrors FAQ page) ============ */
main{flex:1 0 auto;padding:24px 0 56px}
.card{background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}
.head{padding:26px 24px 24px;margin-bottom:20px;text-align:center}
h1{margin:0 0 6px;font-size:clamp(22px,2.5vw,30px);font-weight:700;color:var(--ink-strong);
  letter-spacing:-.01em;line-height:1.25;text-wrap:balance}
h1 em{font-style:normal;color:var(--orange)}
.rule{width:64px;height:3px;background:var(--orange);border-radius:2px;margin:0 auto 14px}
.head p{margin:0 auto 20px;max-width:620px;color:var(--ink-soft);font-size:14px}
.sform{display:flex;gap:10px;max-width:660px;margin:0 auto;align-items:stretch}
.sinput{position:relative;flex:1}
.sinput svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ink-faint)}
#q{width:100%;height:38px;padding:6px 12px 6px 36px;border:1px solid var(--line-input);border-radius:var(--r);
  background:#fff;font-family:inherit;font-size:14px;color:var(--ink)}
#q:focus{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px rgba(250,162,33,.18)}
#q::placeholder{color:var(--ink-faint)}
.sform .btn{border-radius:var(--r);padding:6px 20px;height:38px}
/* --- search in the Help Center bar: reachable from every page --- */
.ssearch{position:relative;flex-shrink:0;width:214px}
.ssearch svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--ink-faint);pointer-events:none}
#qs{width:100%;height:32px;padding:5px 10px 5px 31px;border:1px solid var(--line-input);border-radius:var(--r);
  background:#fff;font-family:inherit;font-size:13.5px;color:var(--ink)}
#qs:focus{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px rgba(250,162,33,.18)}
#qs::placeholder{color:var(--ink-faint)}
/* --- "Start here" shortcuts on the home page --- */
.start{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:center}
.start>span{font-size:11.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-faint)}
.start>a{display:inline-flex;align-items:center;font-size:13px;font-weight:600;color:var(--ink-strong);
  background:var(--white);border:1px solid var(--line-input);border-radius:100px;padding:6px 14px;
  transition:border-color .15s,color .15s}
.start>a:hover{border-color:var(--orange);color:var(--orange-dk)}
/* --- why a search result matched --- */
.snip{display:block;font-size:13px;font-weight:400;color:var(--ink-soft);line-height:1.55;margin-top:4px}
.snip mark{background:var(--orange-tint);color:var(--ink-strong);padding:0 1px;border-radius:2px}
/* --- section jump links on long category pages --- */
.secjump{margin-bottom:16px}
.sec{scroll-margin-top:120px}
.metaline{margin-top:16px;font-size:13px;color:var(--ink-faint)}
.metaline b{color:var(--ink);font-weight:600}
.metaline span+span:before{content:"·";margin:0 9px;color:var(--line-input)}

/* ============ two-column layout (content + Topics) ============ */
.cols{display:grid;grid-template-columns:1fr 264px;gap:20px;align-items:start}
.aside{position:sticky;top:calc(var(--nav-h) + 46px + 20px)}
.aside .card{padding:20px}
.aside h3{margin:0 0 12px;font-size:20px;font-weight:600;color:var(--ink-strong)}
.aside ul{list-style:none;margin:0;padding:0}
.aside li+li{margin-top:2px}
.aside a{display:flex;justify-content:space-between;gap:8px;font-size:14px;color:var(--ink);
  padding:6px 8px;border-radius:4px;transition:background .13s,color .13s}
.aside a:hover{background:var(--page);color:var(--orange)}
.aside a.on{color:var(--orange);font-weight:600;background:var(--orange-tint)}
.aside a i{font-style:normal;color:var(--ink-faint);font-size:12.5px;font-weight:400}

/* ============ category cards (home) ============ */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.cat{display:flex;flex-direction:column;padding:20px;background:var(--white);border:1px solid var(--line);
  border-radius:var(--r);box-shadow:var(--sh);transition:border-color .16s,box-shadow .16s,transform .16s}
.cat:hover{border-color:var(--orange);box-shadow:0 4px 12px rgba(0,0,0,.09);transform:translateY(-2px)}
.cat .r1{display:flex;align-items:center;gap:11px;margin-bottom:10px}
.ico{width:34px;height:34px;border-radius:var(--r);background:var(--orange-tint);color:var(--orange-dk);
  display:grid;place-items:center;flex-shrink:0}
.cat:hover .ico{background:var(--orange);color:#fff}
.cat h2{margin:0;font-size:16px;font-weight:700;color:var(--ink-strong);line-height:1.3;flex:1}
.cat p{margin:0 0 14px;font-size:13.5px;color:var(--ink-soft);line-height:1.5}
.cat .foot{margin-top:auto;padding-top:12px;border-top:1px solid var(--line);display:flex;
  align-items:center;justify-content:space-between;gap:10px}
.count{font-size:12.5px;color:var(--ink-faint)}
.more{font-size:13px;font-weight:600;color:var(--orange);display:inline-flex;align-items:center;gap:5px}

/* ============ question rows (mirrors FAQ list) ============ */
.sec{padding:20px 24px 4px}
.sec+.sec{border-top:1px solid var(--line)}
.sec h3{margin:0 0 2px;font-size:20px;font-weight:600;color:var(--ink-strong)}
.sec .n{font-size:13px;color:var(--ink-faint);margin-bottom:6px}
.qlist{list-style:none;margin:0;padding:0}
.q{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);
  font-size:16px;font-weight:400;color:var(--ink);line-height:1.45;min-height:52px;transition:color .14s}
.qlist li:last-child .q{border-bottom:none}
.q:hover{color:var(--orange-dk)}
.q span{flex:1}
.q svg{flex-shrink:0;color:var(--ink-faint);transition:color .14s,transform .14s}
.q:hover svg{color:var(--orange);transform:translateX(2px)}
.q:focus-visible{outline:2px solid var(--orange);outline-offset:2px;border-radius:3px}

/* ============ breadcrumb ============ */
.crumb{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-faint);margin-bottom:14px;flex-wrap:wrap}
.crumb a:hover{color:var(--orange)}
.crumb svg{opacity:.6;flex-shrink:0}

/* ============ category / article page heads ============ */
.pghead{padding:22px 24px;margin-bottom:20px;display:flex;gap:14px;align-items:flex-start}
.pghead .ico{width:42px;height:42px;background:var(--orange);color:#fff}
.pghead h1{text-align:left;margin:0 0 4px;font-size:clamp(20px,2.2vw,26px)}
.pghead p{margin:0;text-align:left;font-size:14px;color:var(--ink-soft);max-width:70ch}
.art{padding:26px 28px 28px}
.art h1{text-align:left;margin:0 0 16px;font-size:clamp(19px,2.1vw,25px);line-height:1.35}
.notice{display:flex;gap:12px;align-items:flex-start;background:var(--orange-tint);
  border:1px solid #F6DFBB;border-radius:var(--r);padding:16px 18px}
.notice svg{color:var(--orange-dk);flex-shrink:0;margin-top:1px}
.notice b{display:block;font-size:14px;font-weight:700;color:var(--ink-strong);margin-bottom:2px}
.notice p{margin:0;font-size:13.5px;color:var(--ink-soft)}
.subhead{margin:26px 0 4px;font-size:15px;font-weight:700;color:var(--ink-strong)}
.pager{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:24px}
.pager a{border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;background:#fff;
  transition:border-color .16s}
.pager a:hover{border-color:var(--orange)}
.pager i{display:block;font-style:normal;font-size:11px;font-weight:700;letter-spacing:.08em;
  text-transform:uppercase;color:var(--ink-faint);margin-bottom:3px}
.pager b{font-weight:400;font-size:14px;color:var(--ink);line-height:1.4}

/* ============ all-topics index ============ */
.jump{display:flex;flex-wrap:wrap;gap:8px;padding:18px 24px;margin-bottom:20px}
.jump a{font-size:13px;border:1px solid var(--line-input);border-radius:4px;padding:5px 11px;color:var(--ink)}
.jump a:hover{border-color:var(--orange);color:var(--orange)}
.acat{padding:20px 24px 6px}
.acat+.acat{border-top:1px solid var(--line)}
.acat .h{display:flex;align-items:center;gap:11px;padding-bottom:10px;border-bottom:2px solid var(--orange);margin-bottom:14px}
.acat .h h2{margin:0;font-size:19px;font-weight:700;color:var(--ink-strong);flex:1}
.acat .h span{font-size:12.5px;color:var(--ink-faint)}
.asec{margin-bottom:16px}
.asec h4{margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint)}
.asec ol{margin:0;padding-left:20px;columns:2;column-gap:34px}
.asec li{font-size:14px;line-height:1.5;margin-bottom:6px;break-inside:avoid;color:var(--ink)}
.asec li a:hover{color:var(--orange)}

/* ============ search results ============ */
.rescount{padding:16px 24px;font-size:14px;color:var(--ink-soft);border-bottom:1px solid var(--line)}
.rescount b{color:var(--ink-strong)}
.reslist{padding:6px 24px 10px}
.path{display:block;font-size:12.5px;color:var(--ink-faint);margin-top:2px}
mark{background:#FDEBCB;color:inherit;padding:0 2px;border-radius:2px}
.empty{padding:56px 24px;text-align:center;color:var(--ink-soft)}
.empty b{display:block;color:var(--ink-strong);font-size:16px;margin-bottom:6px}

/* ============ help band + footer ============ */
.band{margin-top:20px;padding:22px 24px;display:flex;gap:18px;align-items:center;flex-wrap:wrap}
.band .ico{width:40px;height:40px;background:var(--ink-strong);color:#fff}
.band div{flex:1 1 260px}
.band b{display:block;font-size:15px;font-weight:700;color:var(--ink-strong)}
.band p{margin:2px 0 0;font-size:13.5px;color:var(--ink-soft)}
footer{background:var(--white);border-top:1px solid var(--line);flex-shrink:0}
footer .wrap{padding:22px 20px;display:flex;gap:18px;flex-wrap:wrap;align-items:center;
  justify-content:space-between;font-size:13px;color:var(--ink-faint)}
footer .fb{display:flex;align-items:center;gap:10px;color:var(--ink)}
footer .fb img{height:22px;width:auto}
footer nav{display:flex;gap:18px;flex-wrap:wrap}
footer nav a:hover{color:var(--orange)}

/* ============ responsive ============ */
@media (max-width:1080px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .cols{grid-template-columns:1fr}
  .aside{position:static;order:2}
  .aside ul{display:flex;flex-wrap:wrap;gap:6px}
  .aside li+li{margin-top:0}
  .aside a{border:1px solid var(--line-input);border-radius:4px;padding:5px 11px;font-size:13px}
  .aside a i{display:none}
  .aside h3{font-size:16px;margin-bottom:10px}
  .asec ol{columns:1}
}
@media (max-width:900px){
  .navlinks,.navbtns .btn-o{display:none}
  .burger{display:inline-flex}
  .navbtns{margin-left:0}
  .nav.open .navlinks{display:flex;position:absolute;left:0;right:0;top:var(--nav-h);background:#fff;
    flex-direction:column;align-items:stretch;gap:0;padding:6px 20px 12px;border-bottom:1px solid var(--nav-line);
    box-shadow:var(--sh);margin:0}
  .nav.open .navlinks>a{padding:11px 0;border-bottom:1px solid var(--line)}
  .nav.open .navlinks>a.mlogin{display:block;color:var(--orange);font-weight:700;border-bottom:none}
}
@media (max-width:680px){
  .wrap{padding:0 14px}
  .subbar .wrap{flex-wrap:wrap;height:auto;padding-top:8px;padding-bottom:9px;gap:8px 16px;overflow:visible}
  .ssearch{order:3;width:100%}
  .start{gap:6px}
  .start>a{font-size:12.5px;padding:5px 12px}
  .grid{grid-template-columns:1fr}
  .head{padding:20px 16px 18px}
  .sform{flex-wrap:wrap}
  .sinput{flex:1 1 100%}
  .sform .btn{flex:1}
  .sec,.acat,.jump,.reslist,.rescount{padding-left:16px;padding-right:16px}
  .art{padding:20px 16px 22px}
  .pghead{padding:18px 16px;gap:12px}
  .pghead .ico{width:36px;height:36px}
  .q{font-size:15px;gap:10px;align-items:flex-start;padding:13px 0}
  .q svg{margin-top:3px}
  .pager{grid-template-columns:1fr}
  .band{padding:18px 16px}
  .subbar .wrap{gap:16px}
}
@media (max-width:420px){ .brand small{display:none} .subbar .hc{display:none}
  .subbar nav{margin-left:0} }
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
@media print{.nav,.subbar,.band,footer,.jump,.aside{display:none}.card{box-shadow:none;border:0}}

/* ================= readability & rhythm polish ================= */
:root{
  --s1:8px; --s2:12px; --s3:16px; --s4:20px; --s5:26px; --s6:34px;
  --sh:0 1px 2px rgba(23,33,53,.05), 0 2px 6px rgba(23,33,53,.05);
  --sh-up:0 4px 14px rgba(23,33,53,.09);
}
body{font-size:15px;line-height:1.6}
.wrap{max-width:1200px}
main{padding:var(--s5) 0 64px}

/* --- hero: bigger, calmer, easier to hit --- */
.head{padding:36px 28px 32px;margin-bottom:var(--s5)}
h1{font-size:clamp(24px,2.6vw,33px);line-height:1.22}
.rule{margin-bottom:var(--s3)}
.head p{font-size:15.5px;line-height:1.6;max-width:56ch;margin-bottom:var(--s5)}
.sform{max-width:680px;gap:var(--s2)}
#q{height:46px;font-size:15px;padding:6px 14px 6px 40px}
.sinput svg{left:14px}
.sform .btn{height:46px;padding:0 24px;font-size:14.5px}
.metaline{margin-top:var(--s4);font-size:13.5px}

/* --- category cards: aligned rows, consistent blocks --- */
.grid{gap:var(--s4)}
.cat{padding:var(--s4);box-shadow:var(--sh)}
.cat:hover{box-shadow:var(--sh-up)}
.cat .r1{align-items:flex-start;gap:var(--s2);margin-bottom:6px}
.ico{width:36px;height:36px}
.cat h2{font-size:16.5px;line-height:1.35;padding-top:1px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:calc(2 * 1.35em)}
.cat p{font-size:14px;line-height:1.6;margin-bottom:var(--s3);
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:calc(2 * 1.6em)}
.cat .foot{padding-top:var(--s2)}
.count{font-size:13px}
.more{font-size:13.5px}

/* --- section blocks: clear hierarchy under the page title --- */
.sec{padding:var(--s5) 28px var(--s1)}
.sec h3{font-size:17px;font-weight:700;letter-spacing:-.005em;margin-bottom:1px}
.sec .n{font-size:13px;margin-bottom:var(--s1)}

/* --- question rows: roomier, easier to scan and tap --- */
.q{font-size:15.5px;font-weight:600;color:var(--ink-strong);line-height:1.5;
  min-height:58px;padding:16px 0;gap:var(--s3)}
.q:hover{color:var(--orange-dk)}
.q svg{color:#C7CDD6}

/* --- Topics sidebar: lighter, easier to read --- */
.aside .card{padding:var(--s4)}
.aside h3{font-size:17px;font-weight:700;margin-bottom:var(--s2)}
.aside a{font-size:14px;padding:8px 10px;line-height:1.45;align-items:flex-start}
.aside li+li{margin-top:1px}
.aside a i{font-size:12.5px;padding-top:1px}

/* --- page heads --- */
.pghead{padding:var(--s5) 28px;gap:var(--s3);align-items:center;margin-bottom:var(--s5)}
.pghead .ico{width:44px;height:44px}
.pghead h1{font-size:clamp(21px,2.3vw,27px);margin-bottom:5px}
.pghead p{font-size:15px;line-height:1.6;max-width:66ch}
.crumb{font-size:13.5px;margin-bottom:var(--s3)}

/* --- article: the main readability work --- */
.art{padding:var(--s6) 34px var(--s6)}
.art h1{font-size:clamp(21px,2.3vw,28px);line-height:1.3;margin-bottom:var(--s4);max-width:36ch}
.body{font-size:16px;line-height:1.78;color:var(--ink);max-width:72ch}
.body p{margin:0 0 var(--s3);text-wrap:pretty}
.body h2{margin:var(--s6) 0 10px;font-size:18px;font-weight:700;letter-spacing:-.005em}
.body>h2:first-child{margin-top:0}
.body ul{margin:0 0 var(--s3);padding-left:22px}
.body ul li{margin-bottom:9px}
.body ol.steps{margin:0 0 var(--s3)}
.body ol.steps>li{padding-left:38px;margin-bottom:14px}
.body ol.steps>li:before{width:24px;height:24px;font-size:12.5px;top:4px}
.body blockquote{margin:0 0 var(--s3);padding:13px 17px;font-size:15.5px;line-height:1.65}
.body .note,.body .warn,.body .tip{margin:0 0 var(--s3);padding:15px 17px;font-size:15px;line-height:1.68}
.body strong{color:var(--ink-strong)}
