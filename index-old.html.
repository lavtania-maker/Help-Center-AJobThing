    var shown=hits.slice(0,60);
    h+='<div class="rescount"><b>'+hits.length+'</b> result'+(hits.length===1?'':'s')+
       ' for &ldquo;'+esc(s)+'&rdquo;'+(hits.length>shown.length?' &middot; showing the first '+shown.length:'')+
       '</div><div class="reslist"><ul class="qlist">';
    shown.forEach(function(a){
      var tl=a.t.toLowerCase(), inTitle=groups.every(function(g){return g.some(function(w){return tl.indexOf(w)>-1;});});
      h+='<li><a class="q" href="#/a/'+a.u+'"><span>'+hl(a.t,flat)+
         '<span class="path">'+esc(byId[a.c].n)+' &middot; '+esc(a.s)+'</span>'+
         (inTitle?'':snippet(a,flat))+'</span>'+CH+'</a></li>';});
    h+='</ul></div>';
  }
  view.innerHTML=h+'</div>'+topics('')+'</div>'; markNav('');
  bindSearch(s); window.scrollTo(0,0);
}
/* ---------- search wiring: hero input + the one in the Help Center bar ---------- */
var curQ='';
function inputs(){return [document.getElementById('qs'),document.getElementById('q')].filter(Boolean);}
function bindSearch(val){
  curQ=val!==undefined?val:curQ;
  inputs().forEach(function(q){
    if(q.value!==curQ) q.value=curQ;
    if(q.dataset.bound) return;
    q.dataset.bound='1';
    var t;
    q.addEventListener('input',function(){
      var v=q.value; curQ=v;
      inputs().forEach(function(o){if(o!==q&&o.value!==v)o.value=v;});
      clearTimeout(t); t=setTimeout(function(){run(v.trim(),true);},180);
    });
    q.addEventListener('keydown',function(e){
      if(e.key==='Escape'){q.value='';curQ='';run('');}
      if(e.key==='Enter'){e.preventDefault();clearTimeout(t);run(q.value.trim());}
    });
  });
  var go=document.getElementById('sgo');
  if(go) go.onclick=function(){var q=document.getElementById('q');run(q?q.value.trim():curQ);};
  var cl=document.getElementById('scl');
  if(cl) cl.onclick=function(){curQ='';inputs().forEach(function(o){o.value='';});run('');
    var q=document.getElementById('q'); if(q) q.focus();};
}
/* quiet=true while typing: update the address bar without stacking history entries */
function run(v,quiet){
  curQ=v;
  if(!v){ if(location.hash.indexOf('#/s/')===0){location.hash='#/';}else{home();} return; }
  var target='#/s/'+encodeURIComponent(v);
  if(quiet){
    if(location.hash!==target) history.replaceState(null,'',target);
    search(v);
  }else if(location.hash!==target){ location.hash=target; }
  else { search(v); }
}
/* ---------- router ---------- */
function route(){
  var hash=location.hash.replace(/^#/,'')||'/',m;
  if((m=hash.match(/^\/s\/(.*)$/))){
    var q=''; try{q=decodeURIComponent(m[1]);}catch(e){q=m[1];}
    q=q.trim();
    if(q){curQ=q;search(q);return;}
    history.replaceState(null,'','#/'); home(); return;
  }
  if(hash==='/all'){all();return;}
  if((m=hash.match(/^\/c\/([\w-]+)$/))){
    var cs=m[1];
    if(!bySlug[cs]&&CALIAS[cs]){history.replaceState(null,'','#/c/'+CALIAS[cs]);category(CALIAS[cs]);return;}
    category(cs);return;
  }
  if((m=hash.match(/^\/a\/([\w-]+)$/))){
    var as=m[1];
    if(!byUrl[as]&&ALIAS[as]){history.replaceState(null,'','#/a/'+ALIAS[as]);article(ALIAS[as]);return;}
    article(as);return;
  }
  if(hash.charAt(0)==='g'||hash.charAt(0)==='s')return;
  home();
}
window.addEventListener('hashchange',function(){
  var c=location.hash.charAt(1);
  if(c==='g'||(c==='s'&&location.hash.indexOf('#/s/')!==0))return;
  route();
});
document.addEventListener('keydown',function(e){
  if(e.key==='/'){var q=document.getElementById('qs')||document.getElementById('q');
    if(q&&document.activeElement!==q&&['INPUT','TEXTAREA','SELECT'].indexOf(document.activeElement.tagName)<0){
      e.preventDefault();q.focus();}}});
var bg=document.getElementById('burger'),nv=document.getElementById('nav');
if(bg&&nv) bg.addEventListener('click',function(){
  var o=nv.classList.toggle('open'); bg.setAttribute('aria-expanded',o?'true':'false');});
bindSearch('');
route();
})();
</script>
